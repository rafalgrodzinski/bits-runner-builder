Status enum
  Success boxed
  Failure boxed<u32>
;

handleError fun: status u32
;

@export main fun -> u32
  result enum<Status>
  
  match status: enum<Status>::Failure
    handleError(result.val)
  ;

  ret match result
    enum<status>::Success: 0
    enum<Status>::Failure>
      handleError(result.val.u32)
        result.val
    ;
  ;
;