Status enum
  Success boxed
  Failure boxed<u32>
;

handleError fun: result enum<Status>::Failure
  handleErrorStatus(result.val.u32)
;

handleErrorStatus fun: failureVal u32
;

@export main fun -> u32
  result enum<Status>
  
  match result: enum<Status>::Failure
    handleError(result)
  ;

  ret match result
    enum<status>::Success: 0
    enum<Status>::Failure>
        result.val
    ;
  ;
;