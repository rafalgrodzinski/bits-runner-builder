@module B
@import BSys

@export FsNode::Mode enum
    Open
    Create
;

@export FsNode::Kind enum
    File
    Dir
;

@export FsNode blob
    path blob<String>

    /*getKind fun -> enum<FsNode::Kind>

    ;*/

    getFile fun: mode enum<FsNode::Mode> -> enum<Result, ptr<blob<File>>>
        resId u64 <- match mode 
            enum<FsNode::Mode>::Open: @BSys::fileOpen(it.path.adr)
            enum<FsNode::Mode>::Create: @BSys::fileCreate(it.path.adr)
        else: 0

        if resId = 0: ret {}.enum<Result, ptr<blob<File>>>::Failure
        ret {File(resId)}.enum<Result, ptr<blob<File>>>::Success
    ;

    /*getDir fun: mode enum<FsNode::Mode> -> enum<Result, ptr<blob<Dir>>>
    ;*/

    delete fun -> enum<Result>
        ret if @BSys::fileDelete(it.path.string.adr.u64): {}.enum<Result>::Success else: {}.enum<Result>::Failure
    ;
;

@export FsNode fun: path blob<String> -> ptr<blob<FsNode>>
    p_fsNode ptr<blob<FsNode>> <- @BSys::memAlloc(blob<FsNode>.size).ptr<blob<FsNode>>
    p_fsNode.val.path <- path
    ret p_fsNode
;