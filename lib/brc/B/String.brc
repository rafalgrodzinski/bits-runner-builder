@module B

@import BSys

@export String::FOREGROUND_BLACK u8 <- 0b000
@export String::FOREGROUND_BLUE u8 <- 0b001
@export String::FOREGROUND_GREEN u8 <- 0b010
@export String::FOREGROUND_CYAN u8 <- 0b011
@export String::FOREGROUND_RED u8 <- 0b100
@export String::FOREGROUND_MAGENTA u8 <- 0b101
@export String::FOREGROUND_BROWN u8 <- 0b110
@export String::FOREGROUND_GRAY u8 <- 0b111

@export String::BACKGROUND_BLACK u8 <- 0b000_000
@export String::BACKGROUND_RED u8 <- 0b001_000
@export String::BACKGROUND_GREEN u8 <- 0b010_000
@export String::BACKGROUND_BLUE u8 <- 0b011_000
@export String::BACKGROUND_CYAN u8 <- 0b100_000
@export String::BACKGROUND_MAGENTA u8 <- 0b101_000
@export String::BACKGROUND_BROWN u8 <- 0b110_000
@export String::BACKGROUND_WHITE u8 <- 0b111_000

@export String::ATTRIB_BLINK u8 <- 0b01_000_000
@export String::ATTRIB_BRIGHT u8 <- 0b10_000_000

@export String blob
    string data<u8, 64>

    length fun -> u32
        i u32 <- 0
        rep it.string[i] != '\0' and i < it.string.count: i <- i + 1
        ret i
    ;

    isEqual fun: other blob<String> -> bool
        if it.length() != other.length(): ret false

        rep i u32 <- 0, i < it.length(), i <- i + 1
            if it.string[i] != other.string[i]: ret false
        ;

        ret true
    ;

    print fun
        rep i u32 <- 0, it.string[i] != '\0' and i < it.string.count, i <- i+1
            @BSys::printChar(it.string[i])
        ;
    ;

    println fun
        it.print()
        @BSys::printChar('\n')
    ;

    printColor fun: attribute u8
        /*
            \033[X;X;Xm<YOUR_TEXT>\033[0m
            Where each X is a semicolon separated attribute
        */

        // First print the attributes prefix
        String({0x1b, '[', 0}).print()

        // Attribute
        if attribute &? String::ATTRIB_BLINK
            String("5").print()
        else
            String("0").print()
        ;

        // Foreground color
        if (attribute & 0b111) = String::FOREGROUND_RED
            if attribute &? String::ATTRIB_BRIGHT
                String(";91").print()
            else 
                String(";31").print()
            ;
        else if (attribute & 0b111) = String::FOREGROUND_GREEN
            if attribute &? String::ATTRIB_BRIGHT
                String(";92").print()
            else 
                String(";32").print()
            ;
        else if (attribute & 0b111) = String::FOREGROUND_BLUE
            if attribute &? String::ATTRIB_BRIGHT
                String(";94").print()
            else 
                String(";34").print()
            ;
        else if (attribute & 0b111) = String::FOREGROUND_CYAN
            if attribute &? String::ATTRIB_BRIGHT
                String(";96").print()
            else 
                String(";36").print()
            ;
        else if (attribute & 0b111) = String::FOREGROUND_MAGENTA
            if attribute &? String::ATTRIB_BRIGHT
                String(";95").print()
            else 
                String(";35").print()
            ;
        else if (attribute & 0b111) = String::FOREGROUND_BROWN
            if attribute &? String::ATTRIB_BRIGHT
                String(";93").print()
            else 
                String(";33").print()
            ;
        else if (attribute & 0b111) = String::FOREGROUND_GRAY
            if attribute &? String::ATTRIB_BRIGHT
                String(";97").print()
            else 
                String(";37").print()
            ;
        // black
        else
            if attribute &? String::ATTRIB_BRIGHT
                String(";90").print()
            else 
                String(";30").print()
            ;
        ;
 
        // Background
        if (attribute & 0b111_000) = String::BACKGROUND_RED
            String(";41").print()
        else if (attribute & 0b111_000) = String::BACKGROUND_GREEN
            String(";42").print()
        else if (attribute & 0b111_000) = String::BACKGROUND_BLUE
            String(";44").print()
        else if (attribute & 0b111_000) = String::BACKGROUND_CYAN
            String(";46").print()
        else if (attribute & 0b111_000) = String::BACKGROUND_MAGENTA
            String(";45").print()
        else if (attribute & 0b111_000) = String::BACKGROUND_BROWN
            String(";43").print()
        // black
        else
            String(";40").print()
        ;

        // 'm' finishes the attributes
        String("m").print()

        // Then the text
        it.print()

        // And finally reset the attributes
        String({0x1b, '[', '0', 'm', 0}).print()
    ;

    printlnColor fun: attribute u8
        it.printColor(attribute)
        String("\n").print()
    ;

    subString fun: from u32, to u32 -> blob<String>
        string data<u8, 64>

        // determine resulting lenght
        length u32 <- to - from
        if length > string.count: length <- string.count

        // sanity check length
        if length = 0 or to < from
            string[0] <- 0
            ret String(string)
        ;

        // copy data
        rep i u32 <- 0, i < length, i <- i + 1: string[i] <- it.string[from + i]

        // make sure it's 0 terminated
        if string[length - 1] != 0 and length < string.count - 1: string[length] <- 0
        else: string[length - 1] <- 0

        ret String(string)
    ;

    subStringFrom fun: from u32 -> blob<String>
        ret it.subString(from, it.length())
    ;

    subStringTo fun: to u32 -> blob<String>
        ret it.subString(0, to)
    ;

    find fun: other blob<String> -> u32
        length u32 <- it.length()
        otherLength u32 <- other.length()

        // doesn't fit in
        if otherLength > length: ret 0

        rep i u32 <- 0, i <= length - otherLength, i <- i + 1
            subString blob<String> <- it.subString(i, i + otherLength)
            if subString.isEqual(other): ret i
        ;

        ret 0
    ;

    clear fun
        it.string[0] <- '\0'
    ;

    removeLast fun
        length u32 <- it.length()
        if length > 0: it.string[length - 1] <- 0
    ;

    append fun: char u8
        length u32 <- it.length()
        if length < it.string.count - 1
            it.string[length] <- char
            it.string[length + 1] <- '\0'
        ;
    ;
;

@export String fun: string data<u8, 64> -> blob<String>
    inst blob<String>

    inst.string <- string

    ret inst
;

@export StringForBool fun: value bool -> blob<String>
    ret if value: String("true")
    else: String("false")
;

@export StringForChar fun: char u8 -> blob<String>
    string data<u8> <- {char, 0}
    ret String(string)
;

@export StringForU32 fun: value u32 -> blob<String>
    string data<u8, 64>

    length u32 <- 0
    // first get digits in reversed order
    rep true, value > 0, length <- length + 1
        digit u8 <- (value % 10).u8
        string[length] <- digit + '0'
        value <- value / 10
    ;
    // add the terminating 0
    string[length] <- 0
    
    // if nothing to swap, just return
    if length <= 1: ret String(string)

    // and then swap them
    rep i u32 <- 0, i < length / 2, i <- i + 1
        tmp u8 <- string[i]
        string[i] <- string[length - i - 1]
        string[length - i - 1] <- tmp
    ;

    ret String(string)
;


@export StringForU64 fun: value u64 -> blob<String>
    string data<u8, 64>

    length u32 <- 0
    // first get digits in reversed order
    rep true, value > 0, length <- length + 1
        digit u8 <- (value % 10).u8
        string[length] <- digit + '0'
        value <- value / 10
    ;
    // add the terminating 0
    string[length] <- 0
    
    // if nothing to swap, just return
    if length <= 1: ret String(string)

    // and then swap them
    rep i u32 <- 0, i < length / 2, i <- i + 1
        tmp u8 <- string[i]
        string[i] <- string[length - i - 1]
        string[length - i - 1] <- tmp
    ;

    ret String(string)
;

@export StringForS32 fun: value s32 -> blob<String>
    string data<u8, 64>
    currentIndex u32 <- 0

    if value < 0
        string[currentIndex] <- '-'
        currentIndex <- currentIndex + 1
        value <- value * -1
    ;

    startIndex u32 <- currentIndex

    // first get digits in reversed order
    rep true, value > 0
        string[currentIndex] <- ((value % 10) + '0').u8
        value <- value / 10
        currentIndex <- currentIndex + 1
    ;

    // and then swap them
    rep i u32 <- startIndex, i < (startIndex + currentIndex) / 2, i <- i + 1
        tmp u8 <- string[i]
        string[i] <- string[currentIndex - i - 1 + startIndex]
        string[currentIndex - i - 1 + startIndex] <- tmp
    ;

    // add the terminating 0
    string[currentIndex] <- 0

    ret String(string)
;

@export StringHexForU32 fun: value u32 -> blob<String>
    string data<u8, 64> <- {'0', 'x'}
    currentIndex u32 <- 2

    // first get digits in reversed order
    rep true, value > 0
        digit u8 <- (value % 16).u8
        string[currentIndex] <- if digit > 9: digit - 10 + 'a' else: digit + '0'
        value <- value / 16
        currentIndex <- currentIndex + 1
    ;

    // then swap them
    rep i u32 <- 2, i < (2 + currentIndex) / 2, i <- i + 1
        tmp u8 <- string[i]
        string[i] <- string[currentIndex - i - 1 + 2]
        string[currentIndex - i - 1 + 2] <- tmp
    ;

    // add the terminating 0
    string[currentIndex] <- 0

    ret String(string)
;

@export StringForF32 fun: value f32 -> blob<String>
    string data<u8, 64>
    currentIndex u32 <- 0

    // handle negative number
    if value < 0
        string[currentIndex] <- '-'
        currentIndex <- currentIndex + 1
        value <- value * -1.0
    ;

    integralStartIndex u32 <- currentIndex

    // handle integral part
    integral u32 <- value.u32
    rep true, integral > 0
        string[currentIndex] <- (integral % 10).u8 + '0'
        integral <- integral / 10
        currentIndex <- currentIndex + 1
    ;

    dotIndex u32 <- currentIndex

    // add dot
    string[currentIndex] <- '.'
    currentIndex <- currentIndex + 1

    // handle exponent
    exponent u32 <- ((value - value.u32.f32) * 100_000).u32
    rep true, exponent > 0
        string[currentIndex] <- (exponent % 10).u8 + '0'
        exponent <- exponent / 10
        currentIndex <- currentIndex + 1
    ;

    // swap integral digits
    rep i u32 <- integralStartIndex, i < (integralStartIndex + dotIndex) / 2, i <- i + 1
        tmp u8 <- string[i]
        string[i] <- string[dotIndex - 1 - i + integralStartIndex]
        string[dotIndex - 1 - i + integralStartIndex] <- tmp
    ;

    // swap exponent digits
    rep i u32 <- dotIndex + 1, i < (dotIndex + 1 + currentIndex) / 2, i <- i + 1
        tmp u8 <- string[i]
        string[i] <- string[currentIndex - 1 - i + dotIndex + 1]
        string[currentIndex - 1 - i + dotIndex + 1] <- tmp
    ;

    // add trailing zero
    string[currentIndex] <- 0

    ret String(string)
;
