@module B
@import BSys

@export File blob
    resourceId a

    getSize fun -> u64
        ret @BSys::fileGetSize(it.resourceId)
    ;

    read fun: offset u64, size u64, aTarget a -> u64
        ret @BSys::fileRead(it.resourceId, offset, size, aTarget)
    ;
;

@export File::new fun: path blob<String> -> enum<Result, ptr<blob<File>>>
    resourceId a <- @BSys::fileOpen(path.string.adr.ptr<u8>).a
    if resourceId = 0: ret {}.enum<Result, ptr<blob<File>>>::Failure

    pFile ptr<blob<File>> <- @BSys::memAlloc(blob<File>.size).ptr<blob<File>>
    pFile.val.resourceId <- resourceId
    ret {pFile}.enum<Result, ptr<blob<File>>>::Success
;