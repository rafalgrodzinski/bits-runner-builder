@module B
@import BSys

@export File blob
    resId u64

    getSize fun -> u64
        ret @BSys::fileGetSize(it.resId)
    ;

    read fun: offset u64, size u64, aTarget a -> u64
        ret @BSys::fileRead(it.resId, offset, size, aTarget)
    ;

    write fun: aSource a, offset u64, size u64 -> u64
        ret @BSys::fileWrite(it.resId, aSource, offset, size)
    ;

    /*release fun
        @BSys::fileClose(it.resourceId)
        it.resourceId <- 0
    ;*/
;

@export File fun: resId u64 -> ptr<blob<File>>
    p_file ptr<blob<File>> <- @BSys::memAlloc(blob<File>.size).ptr<blob<File>>
    p_file.val.resId <- resId
    ret p_file
;