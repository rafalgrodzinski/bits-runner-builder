@module BSys

// Memory
@extern malloc fun: bytesCount u64 -> a
@extern free fun: address a

@export memAlloc fun: bytesCount u64 -> a
    ret malloc(bytesCount)
;

@export memFree fun: address a
    free(address)
;

// Print
@extern putchar fun: character u32 -> u32

@export FOREGROUND_BLACK u8 <- 0x00
@export FOREGROUND_BLUE u8 <- 0x01
@export FOREGROUND_GREEN u8 <- 0x02
@export FOREGROUND_CYAN u8 <- 0x03
@export FOREGROUND_RED u8 <- 0x04
@export FOREGROUND_MAGENTA u8 <- 0x05
@export FOREGROUND_BROWN u8 <- 0x06
@export FOREGROUND_GRAY u8 <- 0x07

@export BACKGROUND_BLACK u8 <- 0x00
@export BACKGROUND_BLUE u8 <- 0x10
@export BACKGROUND_GREEN u8 <- 0x20
@export BACKGROUND_CYAN u8 <- 0x30
@export BACKGROUND_RED u8 <- 0x40
@export BACKGROUND_MAGENTA u8 <- 0x50
@export BACKGROUND_BROWN u8 <- 0x60
@export BACKGROUND_WHITE u8 <- 0x70

@export ATTRIB_BRIGHT u8 <- 0x08
@export ATTRIB_BLINK u8 <- 0x80

@export printChar fun: character u8
    putchar(character)
;

@export setPrintAttribute fun: attribute u8
    /*
        \033[X;X;Xm<YOUR_TEXT>\033[0m
        Where each X is a semicolon separated attribute
    */

    isFgRed bool <- (attribute & 0b0111) = FOREGROUND_RED
    isFgGreen bool <- (attribute & 0b0111) = FOREGROUND_GREEN
    isFgBlue bool <- (attribute & 0b0111) = FOREGROUND_BLUE
    isFgCyan bool <- (attribute & 0b0111) = FOREGROUND_CYAN
    isFgMagenta bool <- (attribute & 0b0111) = FOREGROUND_MAGENTA
    isFgBrown bool <- (attribute & 0b0111) = FOREGROUND_BROWN
    isFgGray bool <- (attribute & 0b0111) = FOREGROUND_GRAY

    isBgRed bool <- (attribute & 0b0111_0000) = BACKGROUND_RED
    isBgGreen bool <- (attribute & 0b0111_0000) = BACKGROUND_GREEN
    isBgBlue bool <- (attribute & 0b0111_0000) = BACKGROUND_BLUE
    isBgCyan bool <- (attribute & 0b0111_0000) = BACKGROUND_CYAN
    isBgMagenta bool <- (attribute & 0b0111_0000) = BACKGROUND_MAGENTA
    isBgBrown bool <- (attribute & 0b0111_0000) = BACKGROUND_BROWN
    isBgWhite bool <- (attribute & 0b0111_0000) = BACKGROUND_WHITE

    isBlink bool <- attribute &? ATTRIB_BLINK
    isBright bool <- attribute &? ATTRIB_BRIGHT

    // First print the attributes prefix
    putchar(0x1b)
    putchar('[')

    // Attribute
    if isBlink: putchar('5')
    else: putchar('0')

    // Foreground
    putchar(';')
    if isBright: putchar('9') else: putchar('3')

    if isFgRed: putchar('1')
    else if isFgGreen: putchar('2')
    else if isFgBlue: putchar('4')
    else if isFgCyan: putchar('6')
    else if isFgMagenta: putchar('5')
    else if isFgBrown: putchar('3')
    else if isFgGray: putchar('7')
    else: putchar('0')

    // Background
    putchar(';')
    putchar('4')

    if isBgRed: putchar('1')
    else if isBgGreen: putchar('2')
    else if isBgBlue: putchar('4')
    else if isBgCyan: putchar('6')
    else if isBgMagenta: putchar('5')
    else if isBgBrown: putchar('3')
    else if isBgWhite: putchar('7')
    else: putchar('0')

    // 'm' finishes the attributes
    putchar('m')
;

@export resetPrintAttribute fun
    putchar(0x1b)
    putchar('[')
    putchar('0')
    putchar('m')
;
