@import B

@export main fun -> u32
    msg blob<@B::String>
    val_u8 u8
    val_u32 u32
    val_s8 s8
    val_s32 s32
    val_f32 f32
    val_data_f32 data<f32, 6>
    val_data_s32 data<s32, 6>
    val_data_u8 data<u8, 6>

    // uint to u8 to s32 (1)
    @B::String("100 to u8 to s32:").println()
    val_u8 <- 100
    @B::StringForS32(val_u8.s32).println()
    @B::String::println()

    // uint to u8 to s32 (2)
    @B::String("300 to u8 to s32:").println()
    val_u8 <- 300
    @B::StringForS32(val_u8.s32).println()
    @B::String::println()

    // uint to u8 to s32 (3)
    @B::String("100 + 300 to u8 to s32:").println()
    val_u8 <- 100 + 300
    @B::StringForS32(val_u8.s32).println()
    @B::String::println()

    // u8 + u8 to u32
    @B::String("200.u8 + 200.u8 to u32").println()
    @B::StringForU32(200.u8 + 200.u8).println()
    @B::String::println()

    // sint to u32 to s32
    @B::String("-4 to u32 to s32:").println()
    val_u32 <- (-4).u32
    @B::StringForS32(val_u32.s32).println()
    @B::String::println()

    // sint to s32 to s8
    @B::String("-300 to s32 to s8:").println()
    val_s32 <- -300
    @B::StringForS32(val_s32.s8).println()
    @B::String::println()

    // uint to s8
    @B::String("300 to s8").println()
    val_s8 <- 300
    @B::StringForS32(val_s8).println()
    @B::String::println()

    // sint to s8
    @B::String("-300 to s8").println()
    val_s8 <- -300
    @B::StringForS32(val_s8).println()
    @B::String::println()

    // float to s32 to u32
    @B::String("-7.1234 to s32 to u32:").println()
    val_s32 <- (-7.1234).s32
    @B::StringForU32(val_s32.u32).println()
    @B::String::println()

    // float to f32 to u8
    @B::String("3.141592 to f32 to u8:").println()
    val_f32 <- 3.141592
    @B::StringForU32(val_f32.u8).println()
    @B::String::println()

    // data<f32> to data<s32> to data<u8>
    @B::String("data<f32> to data<s32> to data<u8>:").println()

    val_data_f32 <- {-7.2, -4.4, 12.8, 3.333, 0, 745.88}
    rep i u32 <- 0, i < val_data_f32.count, i <- i + 1
        @B::StringForF32(val_data_f32[i]).print()
        @B::String(" ").print()
    ;
    @B::String::println()
    val_data_s32 <- val_data_f32.data<s32>
    rep i u32 <- 0, i < val_data_s32.count, i <- i + 1
        @B::StringForS32(val_data_s32[i]).print()
        @B::String(" ").print()
    ;
    @B::String::println()
    val_data_u8 <- val_data_s32.data<u8>
    rep i u32 <- 0, i < val_data_u8.count, i <- i + 1
        @B::StringForU32(val_data_u8[i]).print()
        @B::String(" ").print()
    ;
    @B::String::println()

    ret 0
;